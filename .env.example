# Optional local API port. Never put provider API keys in this file.
ZHIDIAN_API_PORT=8787

# Optional controlled-private-network binding. Leave unset for loopback-only mode.
# ZHIDIAN_BIND_HOST=192.168.1.10
# ZHIDIAN_PRIVATE_BIND_CONFIRM=I_UNDERSTAND_PRIVATE_TLS
# ZHIDIAN_PRIVATE_CLIENTS=192.168.1.20

# Optional Feishu/Lark inbound callbacks. Requires HTTPS and per-project opt-in.
# ZHIDIAN_ENABLE_INBOUND=1

# Optional override for the encrypted local settings directory.
# ZHIDIAN_DATA_DIR=%APPDATA%\\Zhidian
